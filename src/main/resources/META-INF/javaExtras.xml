<idea-plugin>
    <!-- Java 插件专属扩展点 — 仅在 com.intellij.java 存在时加载 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Java 代码补全（静态分析前置过滤 + 注解/注释感知） -->
        <completion.contributor
            language="JAVA"
            implementationClass="com.deepseek.plugin.completion.JavaCompletionContributor"
            order="first"/>
    </extensions>
</idea-plugin>
