<idea-plugin>
    <id>com.deepseek.plugin</id>
    <name>DeepSeek AI Assistant</name>
    <vendor url="https://github.com/lvesDi005/DeepSeek-AI-CodeHelper">lvesDi005</vendor>
    <description><![CDATA[
        <h2>DeepSeek AI Assistant for JETBRAINS</h2>
        <ul>
          <li><b>Code Completion</b> — AI-powered inline suggestions as you type</li>
          <li><b>Chat Panel</b> — Ask anything in a side-panel chat window</li>
          <li><b>Agent Actions</b> — Right-click to Explain / Review</li>
        </ul>
        <br>
        <p>Configure your API Key in the ⚙Settings</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="javaExtras.xml">com.intellij.java</depends>

    <!-- Application-level services -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Application Service -->
        <applicationService
            serviceImplementation="com.deepseek.plugin.settings.DeepSeekSettings"/>

        <!-- Completion Status Service -->
        <applicationService
            serviceImplementation="com.deepseek.plugin.completion.CompletionStatusService"/>

        <!-- Completion Status Bar Widget -->
        <statusBarWidgetFactory
            id="DeepSeekCompletionStatus"
            implementation="com.deepseek.plugin.completion.CompletionStatusBarWidgetFactory"/>

        <!-- Chat Tool Window -->
        <toolWindow
            id="DeepSeek AI CodeHelper"
            anchor="right"
            icon="com.deepseek.plugin.icons.PluginIcons.TOOLWINDOW"
            factoryClass="com.deepseek.plugin.chat.ChatToolWindowFactory"/>

        <!-- Code Completion -->
        <completion.contributor
            language="any"
            implementationClass="com.deepseek.plugin.completion.DeepSeekCompletionContributor"
            order="last"/>

        <!-- Paste Image Handler — 拦截编辑器粘贴，检测图片保存到聊天附件 -->
        <editorActionHandler
            action="EditorPaste"
            order="first"
            implementationClass="com.deepseek.plugin.handler.PasteImageHandler"/>

        <!-- Notification group -->
        <notificationGroup
            id="DeepSeek AI CodeHelper"
            displayType="BALLOON"/>

    </extensions>

    <!-- Editor Action Handlers -->
    <actions>
        <!-- Tab Key Handler for Ghost Text Accept -->
        <action id="DeepSeekAI.AcceptGhostText"
                class="com.deepseek.plugin.completion.AcceptGhostTextAction"
                text="Accept DeepSeek Completion"
                description="Accept the Ghost Text completion suggestion"
                use-shortcut-of="EditorTab"/>

        <!-- Manual Trigger: AI Completion (Alt+P) -->
        <action id="DeepSeekAI.TriggerCompletion"
                class="com.deepseek.plugin.completion.DeepSeekTriggerCompletionAction"
                text="AI Completion (Manual)"
                description="Trigger AI code completion manually with deeper context">
            <keyboard-shortcut keymap="$default" first-keystroke="alt P"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- Right-click context menu actions -->
        <group id="DeepSeekAI.AgentGroup" text="DeepSeek AI" icon="com.deepseek.plugin.icons.PluginIcons.ACTION"
               popup="true" description="DeepSeek AI Agent actions">
            <action id="DeepSeekAI.SetLanguage"
                    class="com.deepseek.plugin.agent.SetLanguageAction"
                    text="Set Language"
                    description="Set the output language for agent actions"/>
            <action id="DeepSeekAI.Explain"
                    class="com.deepseek.plugin.agent.ExplainAction"
                    text="Explain Code"
                    description="Explain the selected code in detail"/>
            <action id="DeepSeekAI.Review"
                    class="com.deepseek.plugin.agent.ReviewAction"
                    text="Review Code"
                    description="Code review with suggestions"/>
            <action id="DeepSeekAI.UploadConsole"
                    class="com.deepseek.plugin.agent.UploadConsoleAction"
                    text="Upload to Chat"
                    description="Upload selected console output to the chat panel for AI analysis"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
